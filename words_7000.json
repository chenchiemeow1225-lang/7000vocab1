        let currentFilter = 'all';
        let searchQuery = '';
        let currentPage = 1;
        const itemsPerPage = 12;
        let bookmarks = JSON.parse(localStorage.getItem('vocab_bookmarks')) || [];
        let currentFlashcardIndex = 0;
        let isCardFlipped = false;

        document.addEventListener('DOMContentLoaded', () => {
            updateBookmarkCount();
            renderVocab();
            setupSearch();
        });

        function switchTab(tabId) {
            ['browse', 'flashcard', 'export'].forEach(id => {
                document.getElementById(`tab-${id}`).classList.add('hidden');
                document.getElementById(`nav-${id}`).className = "px-3 py-1.5 rounded-md text-sm font-medium transition text-indigo-100 hover:bg-indigo-600";
            });
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            document.getElementById(`nav-${tabId}`).className = "px-3 py-1.5 rounded-md text-sm font-medium transition bg-white text-indigo-700 shadow";

            if (tabId === 'flashcard') {
                initFlashcard();
            } else if (tabId === 'export') {
                renderBookmarksList();
            }
        }

        function filterLevel(level) {
            currentFilter = level;
            currentPage = 1;
            document.querySelectorAll('.level-btn').forEach(btn => {
                if(btn.dataset.level === level) {
                    btn.className = "level-btn px-3 py-1 text-xs rounded-full bg-indigo-600 text-white font-medium";
                } else {
                    btn.className = "level-btn px-3 py-1 text-xs rounded-full bg-slate-200 text-slate-700 font-medium hover:bg-slate-300";
                }
            });
            renderVocab();
        }

        function setupSearch() {
            document.getElementById('search-input').addEventListener('input', (e) => {
                searchQuery = e.target.value.toLowerCase().trim();
                currentPage = 1;
                renderVocab();
            });
        }

        function getFilteredVocab() {
            return vocabData.filter(item => {
                const matchesLevel = currentFilter === 'all' || item.level === currentFilter;
                const matchesSearch = item.word.toLowerCase().includes(searchQuery) || item.def.toLowerCase().includes(searchQuery) || item.pos.toLowerCase().includes(searchQuery);
                return matchesLevel && matchesSearch;
            });
        }

        function renderVocab() {
            const filtered = getFilteredVocab();
            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            const pageItems = filtered.slice(start, end);

            const grid = document.getElementById('vocab-grid');
            grid.innerHTML = '';

            if (pageItems.length === 0) {
                grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-400">找不到符合條件的單字。</div>`;
                document.getElementById('pagination').innerHTML = '';
                return;
            }

            pageItems.forEach(item => {
                const isBookmarked = bookmarks.some(b => b.word === item.word);
                const card = document.createElement('div');
                card.className = "bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col justify-between hover:shadow-md transition";
                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-start mb-2">
                            <div>
                                <span class="text-xl font-bold text-slate-800">${item.word}</span>
                                <span class="text-xs text-indigo-600 ml-2 font-medium">${item.pos}</span>
                            </div>
                            <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full font-semibold">Level ${item.level}</span>
                        </div>
                        <p class="text-slate-600 text-sm mt-2">${item.def}</p>
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-100 flex justify-end">
                        <button onclick="toggleBookmark('${item.word}')" class="text-xs px-3 py-1.5 rounded-lg font-medium transition flex items-center ${isBookmarked ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}">
                            <i class="${isBookmarked ? 'fa-solid' : 'fa-regular'} fa-star mr-1"></i> ${isBookmarked ? '已加入 Anki 收藏' : '加入收藏'}
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });

            renderPagination(filtered.length);
        }

        function renderPagination(totalItems) {
            const totalPages = Math.ceil(totalItems / itemsPerPage);
            const pagination = document.getElementById('pagination');
            pagination.innerHTML = '';

            if (totalPages <= 1) return;

            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button');
                btn.className = `px-3 py-1 rounded text-xs font-medium ${i === currentPage ? 'bg-indigo-600 text-white' : 'bg-white text-slate-700 border border-slate-300 hover:bg-slate-100'}`;
                btn.innerText = i;
                btn.onclick = () => {
                    currentPage = i;
                    renderVocab();
                };
                pagination.appendChild(btn);
            }
        }

        function toggleBookmark(word) {
            const item = vocabData.find(v => v.word === word);
            if (!item) return;

            const index = bookmarks.findIndex(b => b.word === word);
            if (index > -1) {
                bookmarks.splice(index, 1);
            } else {
                bookmarks.push(item);
            }
            localStorage.setItem('vocab_bookmarks', JSON.stringify(bookmarks));
            updateBookmarkCount();
            renderVocab();
            if(!document.getElementById('tab-export').classList.contains('hidden')) {
                renderBookmarksList();
            }
        }

        function updateBookmarkCount() {
            document.getElementById('bookmark-count').innerText = bookmarks.length;
            document.getElementById('export-count').innerText = bookmarks.length;
        }

        function initFlashcard() {
            currentFlashcardIndex = 0;
            showFlashcard();
        }

        function showFlashcard() {
            const filtered = getFilteredVocab();
            if (filtered.length === 0) {
                document.getElementById('fc-word').innerText = "無可用單字";
                document.getElementById('fc-pos').innerText = "";
                document.getElementById('fc-def').innerText = "請調整篩選條件";
                document.getElementById('flashcard-counter').innerText = "0 / 0";
                return;
            }
            if (currentFlashcardIndex >= filtered.length) currentFlashcardIndex = 0;
            if (currentFlashcardIndex < 0) currentFlashcardIndex = filtered.length - 1;

            const item = filtered[currentFlashcardIndex];
            isCardFlipped = false;
            document.getElementById('fc-word').innerText = item.word;
            document.getElementById('fc-pos').innerText = item.pos;
            document.getElementById('fc-def').innerText = item.def;
            document.getElementById('fc-def-container').classList.add('hidden');
            document.getElementById('flashcard-counter').innerText = `${currentFlashcardIndex + 1} / ${filtered.length}`;
            document.getElementById('flashcard-level').innerText = `Level ${item.level}`;

            const isBookmarked = bookmarks.some(b => b.word === item.word);
            const bmBtn = document.getElementById('fc-bookmark-btn');
            bmBtn.innerHTML = `<i class="${isBookmarked ? 'fa-solid' : 'fa-regular'} fa-star"></i>`;
            bmBtn.className = `px-4 rounded-xl font-medium transition text-sm ${isBookmarked ? 'bg-amber-100 text-amber-600' : 'bg-amber-50 hover:bg-amber-100 text-amber-600'}`;
        }

        function toggleCardFlip() {
            isCardFlipped = !isCardFlipped;
            const defContainer = document.getElementById('fc-def-container');
            if (isCardFlipped) {
                defContainer.classList.remove('hidden');
            } else {
                defContainer.classList.add('hidden');
            }
        }

        function nextFlashcard(direction) {
            currentFlashcardIndex += direction;
            showFlashcard();
        }

        function toggleBookmarkCurrent() {
            const filtered = getFilteredVocab();
            if (filtered.length === 0) return;
            const item = filtered[currentFlashcardIndex];
            toggleBookmark(item.word);
            showFlashcard();
        }

        function renderBookmarksList() {
            const listContainer = document.getElementById('bookmark-list');
            listContainer.innerHTML = '';

            if (bookmarks.length === 0) {
                listContainer.innerHTML = `<div class="py-8 text-center text-slate-400 text-sm">尚未收藏任何單字。</div>`;
                return;
            }

            bookmarks.forEach(item => {
                const row = document.createElement('div');
                row.className = "py-3 flex justify-between items-center";
                row.innerHTML = `
                    <div>
                        <span class="font-bold text-slate-800">${item.word}</span>
                        <span class="text-xs text-indigo-600 ml-2 font-medium">${item.pos}</span>
                        <span class="text-xs text-slate-400 ml-2">Level ${item.level}</span>
                        <p class="text-xs text-slate-600 mt-0.5">${item.def}</p>
                    </div>
                    <button onclick="toggleBookmark('${item.word}'); renderBookmarksList();" class="text-rose-500 hover:text-rose-700 text-sm p-2"><i class="fa-solid fa-xmark"></i></button>
                `;
                listContainer.appendChild(row);
            });
        }

        function exportAnkiTxt() {
            if (bookmarks.length === 0) {
                alert("目前沒有收藏的單字可供匯出！");
                return;
            }

            let txtContent = "";
            bookmarks.forEach(item => {
                txtContent += `${item.word} (${item.pos})\t${item.def} [Level ${item.level}]\n`;
            });

            const blob = new Blob([txtContent], { type: 'text/plain;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `Anki_Vocab_Export_${new Date().toISOString().slice(0,10)}.txt`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        function clearBookmarks() {
            if (confirm("確定要清空所有收藏的單字嗎？")) {
                bookmarks = [];
                localStorage.removeItem('vocab_bookmarks');
                updateBookmarkCount();
                renderVocab();
                renderBookmarksList();
            }
        }
    </script>
</body>
