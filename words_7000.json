<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>學測 7000 單一字多義刷字系統 (V5 + Rainbow)</title>
    <!-- 引入 docx.js 以支援 Word 匯出 -->
    <script src="https://unpkg.com/docx@8.5.0/build/index.umd.js"></script>
    <style>
        :root {
            --bg: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #0f172a;
            --text-sub: #64748b;
            --border: #e2e8f0;
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --accent-blue: #0284c7;
            --sense-bg: #fafafa;
            --sense-border: #f0f0f0;
            --modal-bg: rgba(0, 0, 0, 0.5);
            --modal-content-bg: #ffffff;
            --pre-bg: #1e293b;
            --pre-text: #f8fafc;
            --card-glow: none;
        }

        /* 1. V5 原汁原味深色主題樣式 */
        [data-theme="dark"] {
            --bg: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f8fafc;
            --text-sub: #94a3b8;
            --border: #334155;
            --primary: #6366f1;
            --primary-hover: #4f46e5;
            --accent-blue: #38bdf8;
            --sense-bg: #0f172a;
            --sense-border: #334155;
            --modal-bg: rgba(0, 0, 0, 0.75);
            --modal-content-bg: #1e293b;
            --pre-bg: #020617;
            --pre-text: #e2e8f0;
            --card-glow: none;
        }

        /* 2. 新增酷炫彩虹模式 (Rainbow Mode) */
        [data-theme="rainbow"] {
            --bg: #0a0a16;
            --card-bg: rgba(20, 20, 45, 0.85);
            --text-main: #ffffff;
            --text-sub: #a5b4fc;
            --border: rgba(255, 255, 255, 0.18);
            --primary: #a855f7;
            --primary-hover: #9333ea;
            --accent-blue: #38bdf8;
            --sense-bg: rgba(15, 15, 35, 0.6);
            --sense-border: rgba(255, 255, 255, 0.12);
            --modal-bg: rgba(0, 0, 0, 0.85);
            --modal-content-bg: #13132b;
            --pre-bg: #070714;
            --pre-text: #f472b6;
            --card-glow: 0 0 25px rgba(168, 85, 247, 0.35);
        }

        /* 彩虹背景流動光影動畫 */
        body[data-theme="rainbow"] {
            background: linear-gradient(125deg, #0a0a16, #1a0b2e, #0f1c3f, #0a1f1d, #1a0b2e);
            background-size: 400% 400%;
            animation: rainbowBG 12s ease infinite;
        }

        @keyframes rainbowBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; transition: background-color 0.25s, color 0.25s, border-color 0.25s, box-shadow 0.25s; }
        body { background-color: var(--bg); color: var(--text-main); padding: 24px 16px; max-width: 800px; margin: 0 auto; min-height: 100vh; }
        
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
        h1 { font-size: 1.5rem; color: var(--text-main); }
        .subtitle { font-size: 0.85rem; color: var(--text-sub); }

        /* 三態切換按鈕區 */
        .theme-switcher {
            display: flex;
            gap: 6px;
            background: var(--card-bg);
            padding: 4px;
            border-radius: 20px;
            border: 1px solid var(--border);
        }

        .theme-btn {
            padding: 6px 12px;
            border-radius: 16px;
            border: none;
            background: transparent;
            color: var(--text-sub);
            font-size: 0.8rem;
            cursor: pointer;
            font-weight: 600;
        }

        .theme-btn.active {
            background: var(--primary);
            color: #ffffff;
        }

        .filter-bar { display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
        .filter-select, .search-input { padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border); background: var(--card-bg); color: var(--text-main); font-size: 0.9rem; outline: none; }
        .search-input { flex: 1; min-width: 160px; }

        .dashboard { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; background: var(--card-bg); padding: 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 20px; box-shadow: var(--card-glow); }
        .stat-box { text-align: center; }
        .stat-val { font-size: 1.4rem; font-weight: 700; color: var(--primary); }
        .stat-label { font-size: 0.75rem; color: var(--text-sub); margin-top: 4px; }

        .card { background: var(--card-bg); border-radius: 16px; border: 1px solid var(--border); padding: 24px; box-shadow: var(--card-glow); margin-bottom: 20px; backdrop-filter: blur(10px); }
        .card-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--border); padding-bottom: 12px; margin-bottom: 16px; }
        .word-title { font-size: 2.2rem; font-weight: 800; color: var(--text-main); }
        
        [data-theme="rainbow"] .word-title {
            background: linear-gradient(90deg, #f43f5e, #a855f7, #38bdf8, #34d399, #fbbf24);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .word-meta { display: flex; gap: 8px; }
        .tag { font-size: 0.75rem; padding: 4px 8px; border-radius: 6px; font-weight: 600; }
        .tag-level { background: #e0e7ff; color: #3730a3; }
        [data-theme="dark"] .tag-level { background: #312e81; color: #c7d2fe; }
        [data-theme="rainbow"] .tag-level { background: rgba(168, 85, 247, 0.2); color: #c084fc; border: 1px solid #a855f7; }
        .tag-pos { background: var(--sense-bg); color: var(--text-sub); border: 1px solid var(--border); }

        .senses-list { display: flex; flex-direction: column; gap: 12px; }
        .sense-item { display: flex; align-items: flex-start; gap: 12px; padding: 12px 14px; border-radius: 10px; background: var(--sense-bg); border: 1px solid var(--sense-border); cursor: pointer; }
        .sense-item.known { opacity: 0.45; }
        .sense-key-badge { background: var(--border); color: var(--text-sub); font-size: 0.75rem; font-weight: bold; padding: 2px 6px; border-radius: 4px; margin-top: 2px; }
        .sense-checkbox { width: 20px; height: 20px; margin-top: 2px; cursor: pointer; accent-color: var(--primary); }
        .sense-content { flex: 1; }
        .sense-def { font-weight: 600; font-size: 1rem; color: var(--text-main); margin-bottom: 4px; }
        .sense-collocation { font-size: 0.85rem; color: var(--accent-blue); background: rgba(2, 132, 199, 0.1); padding: 2px 8px; border-radius: 4px; display: inline-block; margin-bottom: 4px; font-weight: 500; }
        .sense-example { font-size: 0.85rem; color: var(--text-sub); font-style: italic; }

        .controls { display: flex; gap: 12px; }
        .btn { padding: 12px 16px; border-radius: 8px; font-weight: 600; font-size: 0.95rem; border: none; cursor: pointer; }
        .btn-prev { background: var(--border); color: var(--text-main); }
        .btn-prev:hover { opacity: 0.9; }
        .btn-next { background: var(--primary); color: white; flex: 1; }
        .btn-next:hover { background: var(--primary-hover); }
        .btn-export { background: #0f172a; color: white; }
        [data-theme="dark"] .btn-export { background: #334155; }
        [data-theme="rainbow"] .btn-export { background: rgba(255, 255, 255, 0.1); border: 1px solid var(--border); }

        .key-hint { margin-top: 12px; text-align: center; font-size: 0.8rem; color: var(--text-sub); }

        /* 模態視窗 */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: var(--modal-bg); justify-content: center; align-items: center; padding: 16px; z-index: 100; }
        .modal-content { background: var(--modal-content-bg); color: var(--text-main); padding: 24px; border-radius: 12px; width: 100%; max-width: 680px; max-height: 85vh; overflow-y: auto; border: 1px solid var(--border); }
        .modal-header { display: flex; justify-content: space-between; margin-bottom: 16px; font-weight: bold; }
        pre { background: var(--pre-bg); color: var(--pre-text); padding: 14px; border-radius: 8px; font-size: 0.85rem; overflow-x: auto; white-space: pre-wrap; max-height: 300px; line-height: 1.5; }
        .modal-actions { display: flex; gap: 10px; margin-top: 16px; flex-wrap: wrap; }
        .btn-word { background: #2563eb; color: white; }

        /* 67 梗鼓勵視窗特別樣式 */
        .encouragement-card { text-align: center; padding: 12px; }
        .meme-badge { font-size: 2.5rem; margin-bottom: 8px; }
        .meme-title { font-size: 1.3rem; font-weight: 800; color: var(--primary); margin-bottom: 8px; }
        .meme-msg { font-size: 1.1rem; font-weight: 700; color: var(--text-main); margin: 12px 0; background: rgba(99, 102, 241, 0.1); padding: 12px; border-radius: 8px; border: 1px dashed var(--primary); }
    </style>
</head>
<body>

    <header>
        <div>
            <h1>7000 單一字多義速刷系統</h1>
            <div class="subtitle">大考中心 108 課綱詞彙表 ‧ 67梗鼓勵機制與彩虹模式</div>
        </div>
        <div class="theme-switcher">
            <button class="theme-btn" id="btn-theme-light" onclick="setTheme('light')">☀️ 淺色</button>
            <button class="theme-btn" id="btn-theme-dark" onclick="setTheme('dark')">🌙 深色</button>
            <button class="theme-btn" id="btn-theme-rainbow" onclick="setTheme('rainbow')">🌈 彩虹</button>
        </div>
    </header>

    <div class="filter-bar">
        <select class="filter-select" id="level-filter" onchange="applyFilters()">
            <option value="all">所有級別 (All Levels)</option>
            <option value="1">Level 1</option>
            <option value="2">Level 2</option>
            <option value="3">Level 3</option>
            <option value="4">Level 4</option>
            <option value="5">Level 5</option>
            <option value="6">Level 6</option>
        </select>
        <input type="text" class="search-input" id="search-input" placeholder="搜尋單字 (例如: margin)..." oninput="applyFilters()">
    </div>

    <div class="dashboard">
        <div class="stat-box">
            <div class="stat-val" id="stat-current">0 / 0</div>
            <div class="stat-label">當前進度</div>
        </div>
        <div class="stat-box">
            <div class="stat-val" id="stat-retained">0</div>
            <div class="stat-label">保留複習單字數</div>
        </div>
        <div class="stat-box">
            <div class="stat-val" id="stat-unknown-senses">0</div>
            <div class="stat-label">生疏意思總數</div>
        </div>
    </div>

    <div class="card" id="word-card"></div>

    <div class="controls">
        <button class="btn btn-prev" onclick="prevWord()">← 上一個</button>
        <button class="btn btn-next" onclick="nextWord()">下一個 (Space / Enter) →</button>
        <button class="btn btn-export" onclick="showExport()">匯出盲點檔</button>
    </div>

    <div class="key-hint">
        💡 快捷鍵操作：[Space / Enter] 下一個單字 ｜ [1, 2, 3...] 快速切換對應意思勾選狀態
    </div>

    <!-- 匯出 Modal -->
    <div class="modal" id="export-modal">
        <div class="modal-content">
            <div class="modal-header">
                <span>個人盲點特訓清單導出</span>
                <button style="border:none; background:none; cursor:pointer; color:var(--text-main);" onclick="closeExport()">✕</button>
            </div>
            <p style="font-size: 0.85rem; color: var(--text-sub); margin-bottom: 12px;">選擇導出方式：列印排版 Word 檔，或電子卡片 Anki 格式。</p>
            <pre id="export-preview"></pre>
            <div class="modal-actions">
                <button class="btn btn-word" onclick="downloadWordDocx()">匯出 Word 筆記本 (.docx)</button>
                <button class="btn btn-next" onclick="downloadTXT()">下載 Anki 文字檔 (.txt)</button>
                <button class="btn btn-prev" onclick="resetAllProgress()">重置勾選</button>
            </div>
        </div>
    </div>

    <!-- 67梗鼓勵彈窗 Modal -->
    <div class="modal" id="meme-modal">
        <div class="modal-content" style="max-width: 420px;">
            <div class="encouragement-card">
                <div class="meme-badge">🔥 67 達成！</div>
                <div class="meme-title" id="meme-title">累計刷新 67 個單字！</div>
                <div class="meme-msg" id="meme-msg">刷滿67單！太流氣了，繼續677777！</div>
                <button class="btn btn-next" style="width: 100%; margin-top: 12px;" onclick="closeMemeModal()">繼續流氣刷字 🚀</button>
            </div>
        </div>
    </div>

    <script>
        const defaultWordsData = [
            {
                id: 1, word: "margin", level: 4, pos: "n.", label: "【C】",
                senses: [
                    { id: "margin_1", pos: "n.", meaning: "頁邊空白處", collocation: "in the margins", example: "Students wrote notes in the margins.", known: false },
                    { id: "margin_2", pos: "n.", meaning: "贏面差距；利潤", collocation: "by a narrow/wide margin", example: "The party won by a narrow margin. They secured victory by wide margins.", known: false }
                ]
            },
            {
                id: 2, word: "green", level: 1, pos: "adj./n./v.", label: "【adj.】",
                senses: [
                    { id: "green_1", pos: "adj.", meaning: "綠色的", collocation: "green tea / green light", example: "She was wearing a green dress.", known: false },
                    { id: "green_2", pos: "adj.", meaning: "缺乏經驗的；菜鳥的（學測高頻）", collocation: "be green to sth / a green recruit", example: "I'm a bit green to this job, so please bear with me.", known: false },
                    { id: "green_3", pos: "adj.", meaning: "嫉妒的", collocation: "green with envy", example: "When she saw his new sports car, she was green with envy.", known: false }
                ]
            },
            {
                id: 3, word: "address", level: 2, pos: "v./n.", label: "【v./C】",
                senses: [
                    { id: "address_1", pos: "n.", meaning: "地址", collocation: "home address / IP address", example: "Please write your name and address on this form.", known: false },
                    { id: "address_2", pos: "v.", meaning: "處理；應對（議題、問題）（學測高頻）", collocation: "address the issue / address a problem", example: "The government must address the problem of poverty immediately.", known: false },
                    { id: "address_3", pos: "v.", meaning: "向…演講；對…說話", collocation: "address the audience", example: "The principal addressed the students on the first day of school.", known: false }
                ]
            }
        ];

        // 67 梗鼓勵詞庫 (控制在 20 字以內)
        const memeQuotes = [
            "刷滿67單！太流氣了，繼續677777！",
            "67這個數字不簡單，你今天簡直太六七！",
            "第67個單字達陣！保持這個67氣勢！",
            "太強了！累積67個單字，氣場67爆表！",
            "流氣滿點！67單字斬，學測直接穩了！"
        ];

        let wordsData = JSON.parse(localStorage.getItem("ceec_vocab_data_v5")) || defaultWordsData;
        let filteredWords = [...wordsData];
        let currentIndex = 0;
        let browsedCount = parseInt(localStorage.getItem("ceec_browsed_count")) || 0;

        // 主題控制（純粹保留 V5 的 Light/Dark + 新增 Rainbow）
        function initTheme() {
            const savedTheme = localStorage.getItem("ceec_theme_v5_r") || "dark";
            setTheme(savedTheme, false);
        }

        function setTheme(themeName, save = true) {
            document.documentElement.setAttribute("data-theme", themeName);
            document.body.setAttribute("data-theme", themeName);
            
            document.querySelectorAll(".theme-btn").forEach(btn => btn.classList.remove("active"));
            const activeBtn = document.getElementById(`btn-theme-${themeName}`);
            if (activeBtn) activeBtn.classList.add("active");

            if (save) {
                localStorage.setItem("ceec_theme_v5_r", themeName);
            }
        }

        function saveData() { localStorage.setItem("ceec_vocab_data_v5", JSON.stringify(wordsData)); }

        function applyFilters() {
            const levelVal = document.getElementById("level-filter").value;
            const searchVal = document.getElementById("search-input").value.toLowerCase().trim();
            filteredWords = wordsData.filter(w => {
                const matchLevel = (levelVal === "all") || (w.level.toString() === levelVal);
                const matchSearch = w.word.toLowerCase().includes(searchVal);
                return matchLevel && matchSearch;
            });
            currentIndex = 0;
            renderCard();
        }

        function renderCard() {
            const cardEl = document.getElementById("word-card");
            if (filteredWords.length === 0) {
                cardEl.innerHTML = `<div style="text-align:center; padding:40px; color:var(--text-sub);">找不到符合條件的單字</div>`;
                updateStats();
                return;
            }
            const current = filteredWords[currentIndex];
            let sensesHtml = current.senses.map((sense, sIndex) => `
                <div class="sense-item ${sense.known ? 'known' : ''}" onclick="toggleSenseDirect(${sIndex})">
                    <span class="sense-key-badge">${sIndex + 1}</span>
                    <input type="checkbox" class="sense-checkbox" ${sense.known ? 'checked' : ''} onclick="event.stopPropagation();" onchange="toggleSense('${current.word}', ${sIndex}, this.checked)">
                    <div class="sense-content">
                        <div class="sense-def"><span style="color:var(--primary); font-size:0.85rem;">[${sense.pos}]</span> ${sense.meaning}</div>
                        <div class="sense-collocation">常用搭配：${sense.collocation}</div>
                        <div class="sense-example">"${sense.example}"</div>
                    </div>
                </div>
            `).join('');

            cardEl.innerHTML = `
                <div class="card-header">
                    <div class="word-title">${current.word} <span style="font-size:1.1rem; color:var(--text-sub); font-weight:normal;">${current.label || ''}</span></div>
                    <div class="word-meta">
                        <span class="tag tag-level">Level ${current.level}</span>
                        <span class="tag tag-pos">${current.pos}</span>
                    </div>
                </div>
                <div class="senses-list">${sensesHtml}</div>
            `;
            updateStats();
        }

        function toggleSense(wordName, senseIndex, isChecked) {
            const wordObj = wordsData.find(w => w.word === wordName);
            if (wordObj) {
                wordObj.senses[senseIndex].known = isChecked;
                saveData();
                renderCard();
            }
        }

        function toggleSenseDirect(senseIndex) {
            const current = filteredWords[currentIndex];
            if (current && current.senses[senseIndex]) {
                current.senses[senseIndex].known = !current.senses[senseIndex].known;
                saveData();
                renderCard();
            }
        }

        function checkEncouragementTrigger() {
            browsedCount++;
            localStorage.setItem("ceec_browsed_count", browsedCount);
            if (browsedCount > 0 && browsedCount % 67 === 0) {
                trigger67MemeModal();
            }
        }

        function trigger67MemeModal() {
            const randomMsg = memeQuotes[Math.floor(Math.random() * memeQuotes.length)];
            document.getElementById("meme-title").innerText = `累計刷滿 ${browsedCount} 個單字！`;
            document.getElementById("meme-msg").innerText = randomMsg;
            document.getElementById("meme-modal").style.display = "flex";
        }

        function closeMemeModal() {
            document.getElementById("meme-modal").style.display = "none";
        }

        function nextWord() { 
            if (filteredWords.length === 0) return; 
            currentIndex = (currentIndex + 1) % filteredWords.length; 
            renderCard(); 
            checkEncouragementTrigger();
        }

        function prevWord() { 
            if (filteredWords.length === 0) return; 
            currentIndex = (currentIndex - 1 + filteredWords.length) % filteredWords.length; 
            renderCard(); 
        }

        function updateStats() {
            document.getElementById("stat-current").innerText = filteredWords.length > 0 ? `${currentIndex + 1} / ${filteredWords.length}` : `0 / 0`;
            let retainedWordsCount = 0, unknownSensesTotal = 0;
            wordsData.forEach(w => {
                const unknownSenses = w.senses.filter(s => !s.known);
                if (unknownSenses.length > 0) {
                    retainedWordsCount++;
                    unknownSensesTotal += unknownSenses.length;
                }
            });
            document.getElementById("stat-retained").innerText = retainedWordsCount;
            document.getElementById("stat-unknown-senses").innerText = unknownSensesTotal;
        }

        function showExport() {
            let lines = [];
            wordsData.forEach(w => {
                const unknownSenses = w.senses.filter(s => !s.known);
                if (unknownSenses.length === 0) return;
                lines.push(`【${w.word} ${w.label || ''}】 (Level ${w.level})`);
                unknownSenses.forEach(s => {
                    lines.push(`  • [${s.pos}] ${s.meaning}\n    搭配: ${s.collocation}\n    例句: ${s.example}`);
                });
            });
            document.getElementById("export-preview").innerText = lines.join("\n\n") || "太棒了！所有單字皆已掌握！";
            document.getElementById("export-modal").style.display = "flex";
        }

        function closeExport() { document.getElementById("export-modal").style.display = "none"; }

        async function downloadWordDocx() {
            if (typeof docx === 'undefined') {
                alert("Docx 套件載入中，請稍後再試...");
                return;
            }

            const { Document, Packer, Paragraph, TextRun, Table, TableRow, TableCell, WidthType } = docx;

            const retainedData = wordsData.map(w => ({
                ...w,
                retained_senses: w.senses.filter(s => !s.known)
            })).filter(w => w.retained_senses.length > 0);

            if (retainedData.length === 0) {
                alert("目前沒有未掌握的盲點單字！");
                return;
            }

            const rows = [
                new TableRow({
                    children: [
                        new TableCell({
                            width: { size: 30, type: WidthType.PERCENTAGE },
                            children: [new Paragraph({ children: [new TextRun({ text: "單字 / 級別", bold: true, color: "FFFFFF" })] })],
                            shading: { fill: "1E3A8A" }
                        }),
                        new TableCell({
                            width: { size: 70, type: WidthType.PERCENTAGE },
                            children: [new Paragraph({ children: [new TextRun({ text: "未掌握意思 ‧ 搭配詞 ‧ 經典例句", bold: true, color: "FFFFFF" })] })],
                            shading: { fill: "1E3A8A" }
                        })
                    ]
                })
            ];

            retainedData.forEach((item, idx) => {
                const bgHex = idx % 2 === 1 ? "F8FAFC" : "FFFFFF";

                const leftParagraphs = [
                    new Paragraph({
                        children: [
                            new TextRun({ text: item.word + " ", bold: true, size: 26, color: "0F172A" }),
                            new TextRun({ text: (item.label || "") + "\n", bold: true, size: 20, color: "1E3A8A" }),
                            new TextRun({ text: `Level ${item.level} | ${item.pos}`, size: 18, color: "64748B" })
                        ]
                    })
                ];

                const rightParagraphs = [];
                item.retained_senses.forEach(sense => {
                    rightParagraphs.push(
                        new Paragraph({
                            children: [
                                new TextRun({ text: `• [${sense.pos}] `, bold: true, color: "1E3A8A", size: 20 }),
                                new TextRun({ text: `${sense.meaning}\n`, bold: true, color: "0F172A", size: 20 }),
                                new TextRun({ text: "   搭配：", color: "64748B", size: 18 }),
                                new TextRun({ text: `${sense.collocation}\n`, bold: true, color: "0284C7", size: 18 }),
                                new TextRun({ text: "   例句：", color: "64748B", size: 18 }),
                                new TextRun({ text: `“${sense.example}”`, italics: true, color: "334155", size: 18 })
                            ]
                        })
                    );
                });

                rows.push(
                    new TableRow({
                        children: [
                            new TableCell({ children: leftParagraphs, shading: { fill: bgHex } }),
                            new TableCell({ children: rightParagraphs, shading: { fill: bgHex } })
                        ]
                    })
                );
            });

            const doc = new Document({
                sections: [{
                    children: [
                        new Paragraph({ children: [new TextRun({ text: "學測 7000 單一字多義 ‧ 個人盲點特訓筆記本", bold: true, size: 36, color: "1E3A8A" })] }),
                        new Paragraph({ children: [new TextRun({ text: "依據大考中心 108 課綱參考詞彙表 ｜ 預留閱讀劃記與抄寫筆記空間\n\n", size: 20, color: "64748B" })] }),
                        new Table({ rows: rows, width: { size: 100, type: WidthType.PERCENTAGE } })
                    ]
                }]
            });

            const blob = await Packer.toBlob(doc);
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = "ceec_vocab_notebook.docx";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function downloadTXT() {
            let lines = [];
            wordsData.forEach(w => {
                const unknownSenses = w.senses.filter(s => !s.known);
                if (unknownSenses.length === 0) return;
                const front = `${w.word} ${w.label || ''}`.trim();
                const backHtml = unknownSenses.map(s => `${s.meaning} ${s.example}`).join("<br>");
                lines.push(`${front}\t${backHtml}`);
            });

            const blob = new Blob([lines.join("\n")], { type: "text/plain;charset=utf-8;" });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = "anki_ceec_vocab.txt";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function resetAllProgress() {
            if (confirm("確定要重置所有勾選狀態與瀏覽計數嗎？")) {
                wordsData.forEach(w => w.senses.forEach(s => s.known = false));
                browsedCount = 0;
                localStorage.setItem("ceec_browsed_count", 0);
                saveData();
                renderCard();
                closeExport();
            }
        }

        document.addEventListener("keydown", function(e) {
            if (document.activeElement.tagName === "INPUT" || document.activeElement.tagName === "SELECT") return;
            if (e.code === "Space" || e.code === "Enter") { e.preventDefault(); nextWord(); }
            else if (e.code === "ArrowLeft") prevWord();
            else if (e.code === "ArrowRight") nextWord();
            else if (e.key >= "1" && e.key <= "9") toggleSenseDirect(parseInt(e.key) - 1);
        });

        // 初始化
        initTheme();
        renderCard();
    </script>
</body>
</html>
直接在深色模式上面修改裡面配色 修改為大宗網頁深色模式設計的樣子 弄得高級一點

一進去程式默認為淺色模式

