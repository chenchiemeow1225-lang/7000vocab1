    <div class="bg-white rounded-xl max-w-md w-full p-6 shadow-xl border border-slate-200">
      <h3 class="text-lg font-bold text-slate-900 mb-2">📄 匯出盲點單字本 (.docx)</h3>
      <p class="text-sm text-slate-500 mb-4">系統將抓取您 **尚未勾選掌握** 的單字與字義，匯出為方便列印或複習的 Word 表格。</p>
      
      <div class="space-y-4 mb-6">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">匯出範圍</label>
          <select id="exportScope" class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500">
            <option value="current">目前篩選的 Level 級別</option>
            <option value="all">所有 Level (1-6 級全部盲點)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">匯出數量上限 (防止記憶體卡死)</label>
          <select id="exportLimit" class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500">
            <option value="100">前 100 筆盲點字義 (推薦，生成快速)</option>
            <option value="200">前 200 筆盲點字義</option>
            <option value="500">前 500 筆盲點字義</option>
            <option value="0">不限制 (若筆數過多可能耗時較久)</option>
          </select>
        </div>
      </div>

      <div class="flex justify-end gap-3">
        <button onclick="closeExportModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-lg">取消</button>
        <button onclick="executeWordExport()" class="px-4 py-2 text-sm font-medium bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg shadow-sm">開始匯出</button>
      </div>
    </div>
  </div>

  <script>
    // ----------------------------------------------------
    // 全域變數狀態
    // ----------------------------------------------------
    let wordsData = [];           // 從 JSON 載入的完整單字庫
    let knownSenseIds = new Set();// 僅記錄已掌握的意思 ID (節省 localStorage 空間)
    let currentLevel = 'all';     // 當前篩選 Level
    let currentSearchTerm = '';   // 當前搜尋關鍵字
    let searchDebounceTimer = null; // 搜尋 Debounce 計時器

    const STORAGE_KEY = 'ceec_known_sense_ids_v1';

    // ----------------------------------------------------
    // 1. 初始化與資料載入
    // ----------------------------------------------------
    document.addEventListener('DOMContentLoaded', async () => {
      loadSavedProgress();
      await fetchWordsData();
      initSearchDebounce();
    });

    // 從 localStorage 載入已掌握 ID 集合
    function loadSavedProgress() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const arr = JSON.parse(saved);
          knownSenseIds = new Set(arr);
        }
      } catch (e) {
        console.error("無法讀取進度，已自動重設", e);
        knownSenseIds = new Set();
      }
    }

    // 儲存已掌握 ID 集合 (極輕量)
    function saveProgress() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(Array.from(knownSenseIds)));
      } catch (e) {
        alert("儲存進度時發生錯誤 (儲存空間可能不足)");
      }
    }

    // 非同步 Fetch 載入 7000 字 JSON 檔
    async function fetchWordsData() {
      const overlay = document.getElementById('loadingOverlay');
      try {
        const response = await fetch('words_7000.json');
        if (!response.ok) throw new Error(`HTTP 錯誤: ${response.status}`);
        wordsData = await response.json();
        
        // 隱藏 Loading 遮罩
        overlay.classList.add('opacity-0');
        setTimeout(() => overlay.classList.add('hidden'), 300);

        // 首次渲染與統計
        updateStats();
        renderWords();

      } catch (error) {
        console.error('載入 words_7000.json 失敗:', error);
        document.getElementById('loadingSubtext').innerText = '❌ 載入失敗！請確認 words_7000.json 是否存在或伺服器環境。';
        document.getElementById('loadingSubtext').classList.add('text-red-400');
      }
    }

    // ----------------------------------------------------
    // 2. 搜尋 Debounce (250ms) 優化
    // ----------------------------------------------------
    function initSearchDebounce() {
      const input = document.getElementById('searchInput');
      input.addEventListener('input', (e) => {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => {
          currentSearchTerm = e.target.value.trim().toLowerCase();
          renderWords();
        }, 250); // 停止打字 250ms 後執行搜尋
      });
    }

    // ----------------------------------------------------
    // 3. 畫面渲染邏輯
    // ----------------------------------------------------
    function renderWords() {
      const container = document.getElementById('wordListContainer');
      container.innerHTML = '';

      // 過濾符合 Level 與搜尋條件的單字
      const filtered = wordsData.filter(wordObj => {
        const matchLevel = (currentLevel === 'all') || (wordObj.level === Number(currentLevel));
        if (!matchLevel) return false;

        if (!currentSearchTerm) return true;

        // 搜尋匹配：單字、中文意思、搭配詞
        const headwordMatch = wordObj.word.toLowerCase().includes(currentSearchTerm);
        const senseMatch = wordObj.senses.some(s => 
          s.chinese.toLowerCase().includes(currentSearchTerm) ||
          (s.collocation && s.collocation.toLowerCase().includes(currentSearchTerm))
        );
        return headwordMatch || senseMatch;
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="bg-white p-8 rounded-xl text-center border border-slate-200 text-slate-500">
            沒有找到符合條件的單字
          </div>`;
        return;
      }

      // 建立 DOM 節點
      const fragment = document.createDocumentFragment();

      filtered.forEach(wordObj => {
        const card = document.createElement('div');
        card.className = 'bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-sm hover:shadow-md transition-shadow';

        let sensesHTML = wordObj.senses.map((sense) => {
          const isMastered = knownSenseIds.has(sense.id);
          return `
            <div class="flex items-start gap-3 p-2.5 rounded-lg transition-colors ${isMastered ? 'bg-slate-50 opacity-60' : 'bg-slate-50/50 hover:bg-slate-100'}">
              <input type="checkbox" 
                     id="chk_${sense.id}" 
                     ${isMastered ? 'checked' : ''} 
                     onchange="toggleSenseMastery('${sense.id}')"
                     class="mt-1 w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 cursor-pointer">
              
              <label for="chk_${sense.id}" class="flex-1 cursor-pointer select-none">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-200 text-slate-700">${sense.pos}</span>
                  <span class="text-sm font-bold text-slate-900 ${isMastered ? 'line-through text-slate-400' : ''}">${sense.chinese}</span>
                </div>
                
                ${sense.collocation ? `
                  <div class="text-xs text-blue-700 font-medium mt-1">
                    📌 搭配詞：<span class="bg-blue-50 px-1.5 py-0.5 rounded border border-blue-100">${sense.collocation}</span>
                  </div>` : ''}
                
                ${sense.example ? `
                  <div class="text-xs text-slate-600 mt-1.5 italic border-l-2 border-slate-300 pl-2">
                    "${sense.example}"
                  </div>` : ''}
              </label>
            </div>
          `;
        }).join('');

        card.innerHTML = `
          <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-100">
            <div class="flex items-baseline gap-2">
              <h2 class="text-xl font-bold text-slate-900">${wordObj.word}</h2>
              <span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-medium">L${wordObj.level}</span>
            </div>
          </div>
          <div class="space-y-2">
            ${sensesHTML}
          </div>
        `;
        fragment.appendChild(card);
      });

      container.appendChild(fragment);
    }

    // 切換某個意思的掌握狀態
    function toggleSenseMastery(senseId) {
      if (knownSenseIds.has(senseId)) {
        knownSenseIds.delete(senseId);
      } else {
        knownSenseIds.add(senseId);
      }
      saveProgress();
      updateStats();
      renderWords();
    }

    // 切換 Level 篩選
    function filterLevel(level) {
      currentLevel = level;
      document.querySelectorAll('.level-btn').forEach(btn => {
        if (btn.dataset.level == level) {
          btn.className = "level-btn px-3 py-1.5 rounded-lg text-sm font-medium transition-all bg-blue-600 text-white";
        } else {
          btn.className = "level-btn px-3 py-1.5 rounded-lg text-sm font-medium transition-all bg-slate-100 hover:bg-slate-200 text-slate-700";
        }
      });
      renderWords();
    }

    // 更新統計數據
    function updateStats() {
      let totalSenses = 0;
      let unmasteredSenses = 0;

      wordsData.forEach(w => {
        w.senses.forEach(s => {
          totalSenses++;
          if (!knownSenseIds.has(s.id)) {
            unmasteredSenses++;
          }
        });
      });

      const masteredCount = totalSenses - unmasteredSenses;
      const percent = totalSenses === 0 ? 0 : Math.round((masteredCount / totalSenses) * 100);

      document.getElementById('statUnmasteredCount').innerText = unmasteredSenses;
      document.getElementById('statProgressPercent').innerText = `${percent}%`;
    }

    // ----------------------------------------------------
    // 4. Word (.docx) 盲點本匯出 (優化版)
    // ----------------------------------------------------
    function openExportModal() {
      document.getElementById('exportModal').classList.remove('hidden');
    }

    function closeExportModal() {
      document.getElementById('exportModal').classList.add('hidden');
    }

    async function executeWordExport() {
      const scope = document.getElementById('exportScope').value;
      const limit = parseInt(document.getElementById('exportLimit').value, 10);

      // 收集盲點清單
      let unmasteredList = [];

      wordsData.forEach(w => {
        if (scope === 'current' && currentLevel !== 'all' && w.level !== Number(currentLevel)) {
          return;
        }

        w.senses.forEach(s => {
          if (!knownSenseIds.has(s.id)) {
            unmasteredList.push({
              word: w.word,
              level: w.level,
              pos: s.pos,
              chinese: s.chinese,
              collocation: s.collocation || '',
              example: s.example || ''
            });
          }
        });
      });

      if (unmasteredList.length === 0) {
        alert("恭喜！選取範圍內沒有未掌握的盲點字義！");
        closeExportModal();
        return;
      }

      // 若有數量限制，進行截斷
      if (limit > 0 && unmasteredList.length > limit) {
        unmasteredList = unmasteredList.slice(0, limit);
      }

      closeExportModal();

      // 使用 docx.js 生成表格
      const { Document, Packer, Paragraph, TextRun, Table, TableRow, TableCell, WidthType, BorderStyle } = window.docx;

      const tableRows = [
        new TableRow({
          children: [
            new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: "單字 (Level)", bold: true })] })], width: { size: 25, type: WidthType.PERCENTAGE } }),
            new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: "詞性/中文", bold: true })] })], width: { size: 25, type: WidthType.PERCENTAGE } }),
            new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: "重點搭配詞", bold: true })] })], width: { size: 25, type: WidthType.PERCENTAGE } }),
            new TableCell({ children: [new Paragraph({ children: [new TextRun({ text: "例句 / 筆記", bold: true })] })], width: { size: 25, type: WidthType.PERCENTAGE } }),
          ]
        })
      ];

      unmasteredList.forEach(item => {
        tableRows.push(
          new TableRow({
            children: [
              new TableCell({ children: [new Paragraph(`${item.word} (L${item.level})`)] }),
              new TableCell({ children: [new Paragraph(`[${item.pos}] ${item.chinese}`)] }),
              new TableCell({ children: [new Paragraph(item.collocation)] }),
              new TableCell({ children: [new Paragraph(item.example)] }),
            ]
          })
        );
      });

      const doc = new Document({
        sections: [{
          properties: {},
          children: [
            new Paragraph({
              children: [new TextRun({ text: "學測英文 7000 單字盲點特訓本", bold: true, size: 32 })],
              space: { after: 300 }
            }),
            new Table({
              rows: tableRows,
              width: { size: 100, type: WidthType.PERCENTAGE }
            })
          ]
        }]
      });

      const blob = await Packer.toBlob(doc);
      saveAs(blob, `CEEC_Vocab_Unmastered_${new Date().toISOString().slice(0,10)}.docx`);
    }
  </script>
</body>
</html>
2️⃣ 資料檔結構規範：words_7000.json
請在與 index.html 相同的目錄下，建立 words_7000.json 檔案。

每個字義必須帶有唯一的 id（範例格式如下）：

JSON
[
  {
    "word": "observe",
    "level": 4,
    "senses": [
      {
        "id": "observe_1",
        "pos": "vt.",
        "chinese": "觀察；注意到",
        "collocation": "observe a trend / observe changes",
        "example": "Scientists closely observed the movement of the storm."
      },
      {
        "id": "observe_2",
        "pos": "vt.",
        "chinese": "遵守（法律、規則）",
        "collocation": "observe the law / observe rules",
        "example": "Drivers must observe the traffic speed limits at all times."
      },
      {
        "id": "observe_3",
        "pos": "vt.",
        "chinese": "慶祝；過（節日）",
        "collocation": "observe a holiday / observe Christmas",
        "example": "How do local residents observe Thanksgiving in this town?"
      }
    ]
  },
  {
    "word": "margin",
    "level": 5,
    "senses": [
      {
        "id": "margin_1",
        "pos": "n.",
        "chinese": "頁邊空白",
        "collocation": "leave a margin / notes in the margin",
        "example": "She wrote explanatory notes in the margin of her textbook."
      },
      {
        "id": "margin_2",
        "pos": "n.",
        "chinese": "差距；餘地",
        "collocation": "win by a wide margin / safety margin",
        "example": "The candidate won the election by a very narrow margin."
      }
    ]
  }
]
🚀 如何本地測試（解決 CORS 讀檔問題）
因為現代瀏覽器的安全性限制，如果直接滑鼠雙擊開啟 file://.../index.html，呼叫 fetch('words_7000.json') 會被瀏覽器擋下（CORS 存取限制）。

請使用以下任一簡單方法開啟：

VS Code Live Server（最推薦）：
在 VS Code 安裝 Live Server 套件，右鍵點擊 index.html -> 選擇 "Open with Live Server"。

Python 快速啟動：
在資料夾開啟終端機（Terminal），輸入：

Bash
python -m http.server 8000
然後在瀏覽器開啟 http://localhost:8000 即可。

這個是已經做好的7000單嗎

不是，剛才提供的是系統的程式碼架構與資料格式範例，並非完整的 7000 單字庫。

更詳細的說明如下：

1. 剛剛提供的內容包含：
index.html（完整前端主程式）：

已包含 250ms 搜尋防抖、Level 級別篩選、超輕量 localStorage 進度儲存、Word 盲點本防卡頓匯出等所有系統功能。

words_7000.json（資料格式範例/ Schema）：

僅包含 observe 與 margin 等展示用的範例單字，用來示範資料欄位（id、word、level、senses、pos、chinese、collocation、example）該如何構建。

2. 為什麼沒有直接附上 7000 字？
大考中心 7000 單字加上「一字多義、詞性、搭配詞、例句」後，總文字量高達數萬行，無法在單一次對話訊息中完整輸出。

3. 下一步怎麼做？
你需要建立包含完整 7000 字內容的 words_7000.json 檔案。

如果你需要協助建置完整字庫，我們可以透過以下幾種方式來完成：

按 Level 分批生成/建置：例如我們先從 Level 5 & 6（學測與指考高頻盲點區） 或 Level 3 & 4 開始分批建置 JSON 資料。

處理現有文字檔：如果你手頭已有大考中心單字的 Excel/CSV/TXT 文字檔，可以貼上來，我幫你轉換為標準的 JSON 格式。

請在與 index.html 相同的目錄下，建立 words_7000.json 檔案。 我要怎麼做

要在與 index.html 相同的目錄下建立 words_7000.json，請依照你的作業環境選擇以下操作方式：

📍 方法一：使用 VS Code（最推薦）
如果你是用 VS Code 開發，這是最快也最不容易出錯的方法：

在 VS Code 中開啟你放置 index.html 的專案資料夾。

在左側欄「檔案總管（Explorer）」的空白處按右鍵，選擇 「新增檔案 (New File)」。

檔名輸入：words_7000.json（請確保全是小寫、包含底線 _）。

將 JSON 格式的單字資料貼入這個檔案中。

按下 Ctrl + S（Mac 為 Cmd + S）完成儲存。

📍 方法二：使用 Windows 記事本 (Notepad)
開啟 「記事本」。

將 JSON 格式的資料內容貼進記事本中。

點選左上角 「檔案」 ➔ 「另存新檔」。

關鍵步驟（避免副檔名變成 .txt）：

儲存位置：選擇與 index.html 相同的資料夾。

存檔類型：切換為 「所有檔案 (.)」。

檔案名稱：輸入 words_7000.json。

編碼：選擇 UTF-8。

點擊 「儲存」。

📍 方法三：使用 Mac 文字編輯器 (TextEdit)
開啟 「文字編輯器」。

點擊上方選單 「格式」 ➔ 「製作純文字 (Make Plain Text)」（快捷鍵 Cmd + Shift + T）。

貼入 JSON 格式資料。

按 Cmd + S 存檔，儲存位置選擇與 index.html 相同資料夾，檔名設為 words_7000.json，並取消勾選「若未提供副檔名，請使用 .txt」。

