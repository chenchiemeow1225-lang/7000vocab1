  <div class="modal" id="meme-modal">
    <div class="modal-content" style="max-width: 420px;">
      <div class="encouragement-card">
        <div class="meme-badge">🔥 67 達成！</div>
        <div class="meme-title" id="meme-title">累計刷新 67 個單字！</div>
        <div class="meme-msg" id="meme-msg">刷滿67單！太流氣了，繼續677777！</div>
        <button class="btn btn-next" style="width: 100%; margin-top: 12px;" onclick="closeMemeModal()">繼續流氣刷字 🚀</button>
      </div>
    </div>
  </div>

  <script>
    // 全域變數
    let wordsData = [];              // 從 JSON 載入的單字庫
    let filteredWords = [];          // 經 Level / 搜尋過濾後的單字
    let knownSenseIds = new Set();   // 輕量化儲存：已掌握的意思 ID 集合
    let currentIndex = 0;
    let browsedCount = 0;
    let searchDebounceTimer = null;

    const STORAGE_KEY_KNOWN = 'ceec_known_sense_ids_v1';
    const STORAGE_KEY_BROWSED = 'ceec_browsed_count_v1';
    const STORAGE_KEY_THEME = 'ceec_theme_v5_pure';

    const memeQuotes = [
      "刷滿67單！太流氣了，繼續677777！",
      "67這個數字不簡單，你今天簡直太六七！",
      "第67個單字達陣！保持這個67氣勢！",
      "太強了！累積67個單字，氣場67爆表！",
      "流氣滿點！67單字斬，學測直接穩了！"
    ];

    // 初始化流程
    document.addEventListener('DOMContentLoaded', async () => {
      initTheme();
      loadProgress();
      await fetchWordsData();
      initSearchDebounce();
    });

    // 主題切換
    function initTheme() {
      const savedTheme = localStorage.getItem(STORAGE_KEY_THEME) || "light";
      document.documentElement.setAttribute("data-theme", savedTheme);
      document.getElementById("theme-btn").innerText = savedTheme === "dark" ? "☀️ 淺色模式" : "🌙 深色模式";
    }

    function toggleTheme() {
      const currentTheme = document.documentElement.getAttribute("data-theme");
      const newTheme = currentTheme === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", newTheme);
      localStorage.setItem(STORAGE_KEY_THEME, newTheme);
      document.getElementById("theme-btn").innerText = newTheme === "dark" ? "☀️ 淺色模式" : "🌙 深色模式";
    }

    // 讀取進度 (極輕量)
    function loadProgress() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY_KNOWN);
        if (saved) knownSenseIds = new Set(JSON.parse(saved));
        browsedCount = parseInt(localStorage.getItem(STORAGE_KEY_BROWSED)) || 0;
      } catch (e) {
        knownSenseIds = new Set();
        browsedCount = 0;
      }
    }

    // 儲存進度 (只存 ID 陣列，永遠不卡爆 5MB)
    function saveProgress() {
      try {
        localStorage.setItem(STORAGE_KEY_KNOWN, JSON.stringify(Array.from(knownSenseIds)));
        localStorage.setItem(STORAGE_KEY_BROWSED, browsedCount);
      } catch (e) {
        console.error("儲存進度失敗", e);
      }
    }

    // 讀取 words_7000.json
    async function fetchWordsData() {
      const overlay = document.getElementById('loadingOverlay');
      try {
        const response = await fetch('words_7000.json');
        if (!response.ok) throw new Error(`HTTP 錯誤: ${response.status}`);
        wordsData = await response.json();

        // 確保每一個 sense 都有唯一 ID (若 JSON 內沒有則自動產生)
        wordsData.forEach((w, wIdx) => {
          w.senses.forEach((s, sIdx) => {
            if (!s.id) s.id = `${w.word}_${sIdx + 1}`;
          });
        });

        overlay.style.opacity = '0';
        setTimeout(() => overlay.style.display = 'none', 300);

        applyFilters();
      } catch (error) {
        console.error('載入失敗:', error);
        document.getElementById('loadingSubtext').innerText = '❌ 載入失敗！請確認 words_7000.json 是否存在或伺服器環境。';
        document.getElementById('loadingSubtext').style.color = '#f87171';
      }
    }

    // 250ms 防抖搜尋
    function initSearchDebounce() {
      const input = document.getElementById('search-input');
      input.addEventListener('input', () => {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => {
          applyFilters();
        }, 250);
      });
    }

    // 篩選與渲染邏輯
    function applyFilters() {
      const levelVal = document.getElementById("level-filter").value;
      const searchVal = document.getElementById("search-input").value.toLowerCase().trim();

      filteredWords = wordsData.filter(w => {
        const matchLevel = (levelVal === "all") || (w.level.toString() === levelVal);
        if (!matchLevel) return false;

        if (!searchVal) return true;
        const matchHeadword = w.word.toLowerCase().includes(searchVal);
        const matchSense = w.senses.some(s => 
          (s.chinese && s.chinese.toLowerCase().includes(searchVal)) ||
          (s.meaning && s.meaning.toLowerCase().includes(searchVal)) ||
          (s.collocation && s.collocation.toLowerCase().includes(searchVal))
        );
        return matchHeadword || matchSense;
      });

      currentIndex = 0;
      renderCard();
    }

    // 渲染卡片
    function renderCard() {
      const cardEl = document.getElementById("word-card");
      if (filteredWords.length === 0) {
        cardEl.innerHTML = `<div style="text-align:center; padding:40px; color:var(--text-sub);">找不到符合條件的單字</div>`;
        updateStats();
        return;
      }

      const current = filteredWords[currentIndex];

      let sensesHtml = current.senses.map((sense, sIndex) => {
        const isKnown = knownSenseIds.has(sense.id);
        const meaningText = sense.chinese || sense.meaning || '';
        return `
          <div class="sense-item ${isKnown ? 'known' : ''}" onclick="toggleSenseDirect(${sIndex})">
            <span class="sense-key-badge">${sIndex + 1}</span>
            <input type="checkbox" class="sense-checkbox" ${isKnown ? 'checked' : ''} onclick="event.stopPropagation();" onchange="toggleSenseById('${sense.id}', this.checked)">
            <div class="sense-content">
              <div class="sense-def"><span style="color:var(--primary); font-size:0.85rem;">[${sense.pos}]</span> ${meaningText}</div>
              ${sense.collocation ? `<div class="sense-collocation">常用搭配：${sense.collocation}</div>` : ''}
              ${sense.example ? `<div class="sense-example">"${sense.example}"</div>` : ''}
            </div>
          </div>
        `;
      }).join('');

      cardEl.innerHTML = `
        <div class="card-header">
          <div class="word-title">${current.word} <span style="font-size:1.1rem; color:var(--text-sub); font-weight:normal;">${current.label || ''}</span></div>
          <div class="word-meta">
            <span class="tag tag-level">Level ${current.level}</span>
            ${current.pos ? `<span class="tag tag-pos">${current.pos}</span>` : ''}
          </div>
        </div>
        <div class="senses-list">${sensesHtml}</div>
      `;

      updateStats();
    }

    function toggleSenseById(senseId, isChecked) {
      if (isChecked) {
        knownSenseIds.add(senseId);
      } else {
        knownSenseIds.delete(senseId);
      }
      saveProgress();
      renderCard();
    }

    function toggleSenseDirect(senseIndex) {
      const current = filteredWords[currentIndex];
      if (current && current.senses[senseIndex]) {
        const senseId = current.senses[senseIndex].id;
        if (knownSenseIds.has(senseId)) {
          knownSenseIds.delete(senseId);
        } else {
          knownSenseIds.add(senseId);
        }
        saveProgress();
        renderCard();
      }
    }

    // 67 梗觸發
    function checkEncouragementTrigger() {
      browsedCount++;
      saveProgress();
      if (browsedCount > 0 && browsedCount % 67 === 0) {
        trigger67MemeModal();
      }
    }

    function trigger67MemeModal() {
      const randomMsg = memeQuotes[Math.floor(Math.random() * memeQuotes.length)];
      document.getElementById("meme-title").innerText = `累計刷新 ${browsedCount} 個單字！`;
      document.getElementById("meme-msg").innerText = randomMsg;
      document.getElementById("meme-modal").style.display = "flex";
    }

    function closeMemeModal() {
      document.getElementById("meme-modal").style.display = "none";
    }

    function nextWord() {
      if (filteredWords.length === 0) return;
      currentIndex = (currentIndex + 1) % filteredWords.length;
      renderCard();
      checkEncouragementTrigger();
    }

    function prevWord() {
      if (filteredWords.length === 0) return;
      currentIndex = (currentIndex - 1 + filteredWords.length) % filteredWords.length;
      renderCard();
    }

    function updateStats() {
      document.getElementById("stat-current").innerText = filteredWords.length > 0 ? `${currentIndex + 1} / ${filteredWords.length}` : `0 / 0`;

      let retainedWordsCount = 0;
      let unknownSensesTotal = 0;

      wordsData.forEach(w => {
        const unknownSenses = w.senses.filter(s => !knownSenseIds.has(s.id));
        if (unknownSenses.length > 0) {
          retainedWordsCount++;
          unknownSensesTotal += unknownSenses.length;
        }
      });

      document.getElementById("stat-retained").innerText = retainedWordsCount;
      document.getElementById("stat-unknown-senses").innerText = unknownSensesTotal;
    }

    // 匯出 Modal
    function showExport() {
      let lines = [];
      wordsData.forEach(w => {
        const unknownSenses = w.senses.filter(s => !knownSenseIds.has(s.id));
        if (unknownSenses.length === 0) return;
        lines.push(`【${w.word} ${w.label || ''}】 (Level ${w.level})`);
        unknownSenses.forEach(s => {
          const meaningText = s.chinese || s.meaning || '';
          lines.push(`  • [${s.pos}] ${meaningText}${s.collocation ? '\n    搭配: ' + s.collocation : ''}${s.example ? '\n    例句: ' + s.example : ''}`);
        });
      });
      document.getElementById("export-preview").innerText = lines.join("\n\n") || "太棒了！所有單字皆已掌握！";
      document.getElementById("export-modal").style.display = "flex";
    }

    function closeExport() {
      document.getElementById("export-modal").style.display = "none";
    }

    // 匯出 Word
    async function downloadWordDocx() {
      if (typeof docx === 'undefined') {
        alert("Docx 套件載入中，請稍後再試...");
        return;
      }

      const { Document, Packer, Paragraph, TextRun, Table, TableRow, TableCell, WidthType } = docx;

      const retainedData = wordsData.map(w => ({
        ...w,
        retained_senses: w.senses.filter(s => !knownSenseIds.has(s.id))
      })).filter(w => w.retained_senses.length > 0);

      if (retainedData.length === 0) {
        alert("目前沒有未掌握的盲點單字！");
        return;
      }

      const rows = [
        new TableRow({
          children: [
            new TableCell({
              width: { size: 30, type: WidthType.PERCENTAGE },
              children: [new Paragraph({ children: [new TextRun({ text: "單字 / 級別", bold: true, color: "FFFFFF" })] })],
              shading: { fill: "1E3A8A" }
            }),
            new TableCell({
              width: { size: 70, type: WidthType.PERCENTAGE },
              children: [new Paragraph({ children: [new TextRun({ text: "未掌握意思 ‧ 搭配詞 ‧ 經典例句", bold: true, color: "FFFFFF" })] })],
              shading: { fill: "1E3A8A" }
            })
          ]
        })
      ];

      retainedData.forEach((item, idx) => {
        const bgHex = idx % 2 === 1 ? "F8FAFC" : "FFFFFF";

        const leftParagraphs = [
          new Paragraph({
            children: [
              new TextRun({ text: item.word + " ", bold: true, size: 26, color: "0F172A" }),
              new TextRun({ text: (item.label || "") + "\n", bold: true, size: 20, color: "1E3A8A" }),
              new TextRun({ text: `Level ${item.level} ${item.pos ? '| ' + item.pos : ''}`, size: 18, color: "64748B" })
            ]
          })
        ];

        const rightParagraphs = [];
        item.retained_senses.forEach(sense => {
          const meaningText = sense.chinese || sense.meaning || '';
          const children = [
            new TextRun({ text: `• [${sense.pos}] `, bold: true, color: "1E3A8A", size: 20 }),
            new TextRun({ text: `${meaningText}\n`, bold: true, color: "0F172A", size: 20 })
          ];
          if (sense.collocation) {
            children.push(new TextRun({ text: "   搭配：", color: "64748B", size: 18 }));
            children.push(new TextRun({ text: `${sense.collocation}\n`, bold: true, color: "0284C7", size: 18 }));
          }
          if (sense.example) {
            children.push(new TextRun({ text: "   例句：", color: "64748B", size: 18 }));
            children.push(new TextRun({ text: `“${sense.example}”\n`, italics: true, color: "334155", size: 18 }));
          }

          rightParagraphs.push(new Paragraph({ children }));
        });

        rows.push(
          new TableRow({
            children: [
              new TableCell({ children: leftParagraphs, shading: { fill: bgHex } }),
              new TableCell({ children: rightParagraphs, shading: { fill: bgHex } })
            ]
          })
        );
      });

      const doc = new Document({
        sections: [{
          children: [
            new Paragraph({ children: [new TextRun({ text: "學測 7000 單一字多義 ‧ 個人盲點特訓筆記本", bold: true, size: 36, color: "1E3A8A" })] }),
            new Paragraph({ children: [new TextRun({ text: "依據大考中心 108 課綱參考詞彙表 ｜ 預留閱讀劃記與抄寫筆記空間\n\n", size: 20, color: "64748B" })] }),
            new Table({ rows: rows, width: { size: 100, type: WidthType.PERCENTAGE } })
          ]
        }]
      });

      const blob = await Packer.toBlob(doc);
      saveAs(blob, `CEEC_Vocab_Notebook_${new Date().toISOString().slice(0,10)}.docx`);
    }

    // 匯出 Anki TXT
    function downloadTXT() {
      let lines = [];
      wordsData.forEach(w => {
        const unknownSenses = w.senses.filter(s => !knownSenseIds.has(s.id));
        if (unknownSenses.length === 0) return;
        const front = `${w.word} ${w.label || ''}`.trim();
        const backHtml = unknownSenses.map(s => {
          const meaningText = s.chinese || s.meaning || '';
          return `[${s.pos}] ${meaningText} ${s.example ? '<i>' + s.example + '</i>' : ''}`;
        }).join("<br>");
        lines.push(`${front}\t${backHtml}`);
      });

      const blob = new Blob([lines.join("\n")], { type: "text/plain;charset=utf-8;" });
      saveAs(blob, `anki_ceec_vocab_${new Date().toISOString().slice(0,10)}.txt`);
    }

    // 重置所有進度
    function resetAllProgress() {
      if (confirm("確定要重置所有勾選狀態與刷新計數嗎？")) {
        knownSenseIds.clear();
        browsedCount = 0;
        saveProgress();
        renderCard();
        closeExport();
      }
    }

    // 快捷鍵事件
    document.addEventListener("keydown", function(e) {
      if (document.activeElement.tagName === "INPUT" || document.activeElement.tagName === "SELECT") return;
      
      if (e.code === "Space" || e.code === "Enter" || e.code === "ArrowRight") {
        e.preventDefault();
        nextWord();
      } else if (e.code === "ArrowLeft") {
        e.preventDefault();
        prevWord();
      } else if (e.key >= "1" && e.key <= "9") {
        toggleSenseDirect(parseInt(e.key) - 1);
      }
    });
  </script>
</body>
</html>
