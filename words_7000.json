        </select>
        <input type="text" class="search-input" id="search-input" placeholder="搜尋單字 (例如: margin)..." oninput="applyFilters()">
    </div>

    <div class="dashboard">
        <div class="stat-box">
            <div class="stat-val" id="stat-current">0 / 0</div>
            <div class="stat-label">當前進度</div>
        </div>
        <div class="stat-box">
            <div class="stat-val" id="stat-retained">0</div>
            <div class="stat-label">保留複習單字數</div>
        </div>
        <div class="stat-box">
            <div class="stat-val" id="stat-unknown-senses">0</div>
            <div class="stat-label">生疏意思總數</div>
        </div>
    </div>

    <div class="card" id="word-card"></div>

    <div class="controls">
        <button class="btn btn-prev" onclick="prevWord()">← 上一個</button>
        <button class="btn btn-next" onclick="nextWord()">下一個 (Space / Enter) →</button>
        <button class="btn btn-export" onclick="showExport()">匯出盲點檔</button>
    </div>

    <div class="key-hint">
        💡 快捷鍵操作：[Space / Enter] 下一個單字 ｜ [1, 2, 3...] 快速切換對應意思勾選狀態
    </div>

    <div class="export-modal" id="export-modal">
        <div class="modal-content">
            <div class="modal-header">
                <span>個人盲點特訓清單導出</span>
                <button style="border:none; background:none; cursor:pointer;" onclick="closeExport()">✕</button>
            </div>
            <p style="font-size: 0.85rem; color: #64748b; margin-bottom: 12px;">選擇最適合你的導出方式：列印排版 Word 檔，或電子卡片 Anki 格式。</p>
            <pre id="export-preview"></pre>
            <div class="modal-actions">
                <button class="btn btn-word" onclick="downloadWordDocx()">匯出 Word 筆記本 (.docx)</button>
                <button class="btn btn-next" onclick="downloadTXT()">下載 Anki 文字檔 (.txt)</button>
                <button class="btn btn-prev" onclick="resetAllProgress()">重置勾選</button>
            </div>
        </div>
    </div>

    <script>
        const defaultWordsData = [
            {
                id: 1, word: "margin", level: 4, pos: "n.", label: "【C】",
                senses: [
                    { id: "margin_1", pos: "n.", meaning: "頁邊空白處", collocation: "in the margins", example: "Students wrote notes in the margins.", known: false },
                    { id: "margin_2", pos: "n.", meaning: "贏面差距；利潤", collocation: "by a narrow/wide margin", example: "The party won by a narrow margin. They secured victory by wide margins.", known: false }
                ]
            },
            {
                id: 2, word: "green", level: 1, pos: "adj./n./v.", label: "【adj.】",
                senses: [
                    { id: "green_1", pos: "adj.", meaning: "綠色的", collocation: "green tea / green light", example: "She was wearing a green dress.", known: false },
                    { id: "green_2", pos: "adj.", meaning: "缺乏經驗的；菜鳥的（學測高頻）", collocation: "be green to sth / a green recruit", example: "I'm a bit green to this job, so please bear with me.", known: false },
                    { id: "green_3", pos: "adj.", meaning: "嫉妒的", collocation: "green with envy", example: "When she saw his new sports car, she was green with envy.", known: false }
                ]
            },
            {
                id: 3, word: "address", level: 2, pos: "v./n.", label: "【v./C】",
                senses: [
                    { id: "address_1", pos: "n.", meaning: "地址", collocation: "home address / IP address", example: "Please write your name and address on this form.", known: false },
                    { id: "address_2", pos: "v.", meaning: "處理；應對（議題、問題）（學測高頻）", collocation: "address the issue / address a problem", example: "The government must address the problem of poverty immediately.", known: false },
                    { id: "address_3", pos: "v.", meaning: "向…演講；對…說話", collocation: "address the audience", example: "The principal addressed the students on the first day of school.", known: false }
                ]
            }
        ];

        let wordsData = JSON.parse(localStorage.getItem("ceec_vocab_data_v4")) || defaultWordsData;
        let filteredWords = [...wordsData];
        let currentIndex = 0;

        function saveData() { localStorage.setItem("ceec_vocab_data_v4", JSON.stringify(wordsData)); }

        function applyFilters() {
            const levelVal = document.getElementById("level-filter").value;
            const searchVal = document.getElementById("search-input").value.toLowerCase().trim();
            filteredWords = wordsData.filter(w => {
                const matchLevel = (levelVal === "all") || (w.level.toString() === levelVal);
                const matchSearch = w.word.toLowerCase().includes(searchVal);
                return matchLevel && matchSearch;
            });
            currentIndex = 0;
            renderCard();
        }

        function renderCard() {
            const cardEl = document.getElementById("word-card");
            if (filteredWords.length === 0) {
                cardEl.innerHTML = `<div style="text-align:center; padding:40px; color:#64748b;">找不到符合條件的單字</div>`;
                updateStats();
                return;
            }
            const current = filteredWords[currentIndex];
            let sensesHtml = current.senses.map((sense, sIndex) => `
                <div class="sense-item ${sense.known ? 'known' : ''}" onclick="toggleSenseDirect(${sIndex})">
                    <span class="sense-key-badge">${sIndex + 1}</span>
                    <input type="checkbox" class="sense-checkbox" ${sense.known ? 'checked' : ''} onclick="event.stopPropagation();" onchange="toggleSense('${current.word}', ${sIndex}, this.checked)">
                    <div class="sense-content">
                        <div class="sense-def"><span style="color:#6366f1; font-size:0.85rem;">[${sense.pos}]</span> ${sense.meaning}</div>
                        <div class="sense-collocation">常用搭配：${sense.collocation}</div>
                        <div class="sense-example">"${sense.example}"</div>
                    </div>
                </div>
            `).join('');

            cardEl.innerHTML = `
                <div class="card-header">
                    <div class="word-title">${current.word} <span style="font-size:1.1rem; color:#64748b; font-weight:normal;">${current.label || ''}</span></div>
                    <div class="word-meta">
                        <span class="tag tag-level">Level ${current.level}</span>
                        <span class="tag tag-pos">${current.pos}</span>
                    </div>
                </div>
                <div class="senses-list">${sensesHtml}</div>
            `;
            updateStats();
        }

        function toggleSense(wordName, senseIndex, isChecked) {
            const wordObj = wordsData.find(w => w.word === wordName);
            if (wordObj) {
                wordObj.senses[senseIndex].known = isChecked;
                saveData();
                renderCard();
            }
        }

        function toggleSenseDirect(senseIndex) {
            const current = filteredWords[currentIndex];
            if (current && current.senses[senseIndex]) {
                current.senses[senseIndex].known = !current.senses[senseIndex].known;
                saveData();
                renderCard();
            }
        }

        function nextWord() { if (filteredWords.length === 0) return; currentIndex = (currentIndex + 1) % filteredWords.length; renderCard(); }
        function prevWord() { if (filteredWords.length === 0) return; currentIndex = (currentIndex - 1 + filteredWords.length) % filteredWords.length; renderCard(); }

        function updateStats() {
            document.getElementById("stat-current").innerText = filteredWords.length > 0 ? `${currentIndex + 1} / ${filteredWords.length}` : `0 / 0`;
            let retainedWordsCount = 0, unknownSensesTotal = 0;
            wordsData.forEach(w => {
                const unknownSenses = w.senses.filter(s => !s.known);
                if (unknownSenses.length > 0) {
                    retainedWordsCount++;
                    unknownSensesTotal += unknownSenses.length;
                }
            });
            document.getElementById("stat-retained").innerText = retainedWordsCount;
            document.getElementById("stat-unknown-senses").innerText = unknownSensesTotal;
        }

        function showExport() {
            let lines = [];
            wordsData.forEach(w => {
                const unknownSenses = w.senses.filter(s => !s.known);
                if (unknownSenses.length === 0) return;
                lines.push(`【${w.word} ${w.label || ''}】 (Level ${w.level})`);
                unknownSenses.forEach(s => {
                    lines.push(`  • [${s.pos}] ${s.meaning}\n    搭配: ${s.collocation}\n    例句: ${s.example}`);
                });
            });
            document.getElementById("export-preview").innerText = lines.join("\n\n") || "太棒了！所有單字皆已掌握！";
            document.getElementById("export-modal").style.display = "flex";
        }

        function closeExport() { document.getElementById("export-modal").style.display = "none"; }

        // 使用 docx.js 動態生成美觀 Word 檔
        async function downloadWordDocx() {
            if (typeof docx === 'undefined') {
                alert("Docx 套件載入中，請稍後再試...");
                return;
            }

            const { Document, Packer, Paragraph, TextRun, Table, TableRow, TableCell, WidthType, BorderStyle } = docx;

            const retainedData = wordsData.map(w => ({
                ...w,
                retained_senses: w.senses.filter(s => !s.known)
            })).filter(w => w.retained_senses.length > 0);

            if (retainedData.length === 0) {
                alert("目前沒有未掌握的盲點單字！");
                return;
            }

            const rows = [
                new TableRow({
                    children: [
                        new TableCell({
                            width: { size: 30, type: WidthType.PERCENTAGE },
                            children: [new Paragraph({ children: [new TextRun({ text: "單字 / 級別", bold: true, color: "FFFFFF" })] })],
                            shading: { fill: "1E3A8A" }
                        }),
                        new TableCell({
                            width: { size: 70, type: WidthType.PERCENTAGE },
                            children: [new Paragraph({ children: [new TextRun({ text: "未掌握意思 ‧ 搭配詞 ‧ 經典例句", bold: true, color: "FFFFFF" })] })],
                            shading: { fill: "1E3A8A" }
                        })
                    ]
                })
            ];

            retainedData.forEach((item, idx) => {
                const bgHex = idx % 2 === 1 ? "F8FAFC" : "FFFFFF";

                const leftParagraphs = [
                    new Paragraph({
                        children: [
                            new TextRun({ text: item.word + " ", bold: true, size: 26, color: "0F172A" }),
                            new TextRun({ text: (item.label || "") + "\n", bold: true, size: 20, color: "1E3A8A" }),
                            new TextRun({ text: `Level ${item.level} | ${item.pos}`, size: 18, color: "64748B" })
                        ]
                    })
                ];

                const rightParagraphs = [];
                item.retained_senses.forEach(sense => {
                    rightParagraphs.push(
                        new Paragraph({
                            children: [
                                new TextRun({ text: `• [${sense.pos}] `, bold: true, color: "1E3A8A", size: 20 }),
                                new TextRun({ text: `${sense.meaning}\n`, bold: true, color: "0F172A", size: 20 }),
                                new TextRun({ text: "   搭配：", color: "64748B", size: 18 }),
                                new TextRun({ text: `${sense.collocation}\n`, bold: true, color: "0284C7", size: 18 }),
                                new TextRun({ text: "   例句：", color: "64748B", size: 18 }),
                                new TextRun({ text: `“${sense.example}”`, italics: true, color: "334155", size: 18 })
                            ]
                        })
                    );
                });

                rows.push(
                    new TableRow({
                        children: [
                            new TableCell({ children: leftParagraphs, shading: { fill: bgHex } }),
                            new TableCell({ children: rightParagraphs, shading: { fill: bgHex } })
                        ]
                    })
                );
            });

            const doc = new Document({
                sections: [{
                    children: [
                        new Paragraph({
                            children: [new TextRun({ text: "學測 7000 單一字多義 ‧ 個人盲點特訓筆記本", bold: true, size: 36, color: "1E3A8A" })]
                        }),
                        new Paragraph({
                            children: [new TextRun({ text: "依據大考中心 108 課綱參考詞彙表 ｜ 預留閱讀劃記與抄寫筆記空間\n\n", size: 20, color: "64748B" })]
                        }),
                        new Table({ rows: rows, width: { size: 100, type: WidthType.PERCENTAGE } })
                    ]
                }]
            });

            const blob = await Packer.toBlob(doc);
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = "ceec_vocab_notebook.docx";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function downloadTXT() {
            let lines = [];
            wordsData.forEach(w => {
                const unknownSenses = w.senses.filter(s => !s.known);
                if (unknownSenses.length === 0) return;
                const front = `${w.word} ${w.label || ''}`.trim();
                const backHtml = unknownSenses.map(s => `${s.meaning} ${s.example}`).join("<br>");
                lines.push(`${front}\t${backHtml}`);
            });

            const blob = new Blob([lines.join("\n")], { type: "text/plain;charset=utf-8;" });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = "anki_ceec_vocab.txt";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function resetAllProgress() {
            if (confirm("確定要重置所有勾選狀態嗎？")) {
                wordsData.forEach(w => w.senses.forEach(s => s.known = false));
                saveData();
                renderCard();
                closeExport();
            }
        }

        document.addEventListener("keydown", function(e) {
            if (document.activeElement.tagName === "INPUT" || document.activeElement.tagName === "SELECT") return;
            if (e.code === "Space" || e.code === "Enter") { e.preventDefault(); nextWord(); }
            else if (e.code === "ArrowLeft") prevWord();
            else if (e.code === "ArrowRight") nextWord();
            else if (e.key >= "1" && e.key <= "9") toggleSenseDirect(parseInt(e.key) - 1);
        });

        renderCard();
    </script>
</body>
</html>
